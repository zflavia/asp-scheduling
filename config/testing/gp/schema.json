{
    "title": "TESTING schema GP",
    "type": "object",
    "properties": {
         "sp_type": {
            "type": "string"
        },
        "algorithm": {
            "type": "string",
            "enum": ["gp-1tree", "gp-2trees"],
            "description": "The algorithm to use — only 'gp-1tree' and 'gp-2trees' is valid for this template."
        },
        "instances_file": {
            "type": "string"
        },
        "environment": {
            "type": "string"
        },
        "saved_model_name": {
            "type": "string"
        },
        "seed": {
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
        },
        "config_description": {
            "type": "string"
        },
        "experiment_save_path": {
            "type": "string"
        },
        "wandb_mode": {
            "type": "integer"
        },
        "wandb_project": {
            "type": "string"
        },
        "evaluation_type": {
            "type": "string",
            "enum": ["best", "assemble", "assemble-instances"],
            "description": "The algorithm to use — only 'best', 'assemble' and 'assemble-instance' is valid for this template."
          }
    },
    "required": [
        "sp_type",
        "algorithm",
        "instances_file",
        "environment",
        "seed",
        "evaluation_type"
    ]
}
